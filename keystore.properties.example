# Copy this file to `keystore.properties` and fill in your own values.
# `keystore.properties` is git-ignored — never commit it, and keep a backup of both
# the file and the .jks somewhere safe. Losing the upload key means you have to ask
# Google to reset it before you can publish another update.

# Path to the keystore, relative to the project root.
storeFile=upload-keystore.jks

# The password you chose when running keytool.
storePassword=CHANGE_ME

# The alias you passed to keytool -alias.
keyAlias=upload

# The key password. keytool uses the store password when you press Enter at the
# "key password" prompt, in which case this is the same value as storePassword.
keyPassword=CHANGE_ME
